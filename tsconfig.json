{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@zombie-coop/shared": ["./packages/shared/src/index.ts"],
      "@zombie-coop/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/shared/src",
    "packages/shared/test",
    "packages/server/src",
    "packages/client/src"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
